{
  "functions": {
    "api/seo.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "neocoat.co.kr"
        }
      ],
      "destination": "https://www.neocoat.co.kr/:path*",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/sitemap-seoul",
      "dest": "/api/seo?path=/sitemap-seoul"
    },
    {
      "src": "/privacy-policy",
      "dest": "/api/seo?path=/privacy-policy"
    },
    {
      "src": "/terms",
      "dest": "/api/seo?path=/terms"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "k"
        }
      ],
      "dest": "/api/seo?path=/"
    },
    {
      "src": "/",
      "dest": "/api/seo?path=/"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/seo"
    }
  ]
}
